# Copy to arr/.env and adjust. This file is the ONLY place with tunable values —
# docker-compose.yml references them as required vars (${VAR:?...}) and contains
# no defaults of its own.

# User/group the stack containers run as (must exist on the host; the Ansible
# playbook creates `arruser` with uid/gid 1000 by default). Also used as the
# literal user Seerr runs as.
PUID=1000
PGID=1000
TZ=Etc/UTC

# Host paths for your library and in-progress downloads. These are mounted at
# the SAME path inside sonarr/radarr/qbittorrent so imports work unchanged.
MEDIA_PATH=/opt/containarr/media
DOWNLOADS_PATH=/opt/containarr/downloads

# Seerr log level: error | warn | info | verbose | debug
SEERR_LOG_LEVEL=info

# Host-side ports for direct (IP:port) access — kept for recovery if the proxy
# is down. Container-internal ports are fixed and live in proxy/config/config.yml.
SONARR_PORT=8989
RADARR_PORT=7878
JACKETT_PORT=9117
QBITTORRENT_WEBUI_PORT=8080
SEERR_PORT=5055
P2P_PORT=6881
