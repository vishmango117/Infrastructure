# Copy to proxy/.env and adjust.

# Every service is reachable at <service>.${DOMAIN_NAME}
# (routers are generated in config/config.yml from this value).
DOMAIN_NAME=example.internal

# Subdomain that serves the Traefik dashboard.
SUBDOMAIN_NAME=traefik

# Host ports Traefik itself listens on. Service backend ports are fixed
# container ports defined in config/config.yml.
HTTP_PORT=80
HTTPS_PORT=443
